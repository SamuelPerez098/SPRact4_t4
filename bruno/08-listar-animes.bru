meta {
  name: 08 - Listar animes (200)
  type: http
  seq: 8
}

get {
  url: http://3.148.185.31:8085/api/figuras
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200 && res.body.length > 0) {
    bru.setVar("animeId", res.body[0].id);
  }
}
